{
  "name": "TizenTivi",
  "version": "1.4.0",
  "type": "module",
  "description": "Remote-first IPTV player for TizenBrew",
  "packageType": "app",
  "appName": "TizenTivi",
  "appPath": "app/index.html",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlay", "MediaPause", "MediaPlayPause", "MediaStop",
    "MediaFastForward", "MediaRewind", "MediaTrackPrevious", "MediaTrackNext",
    "ColorF0Red", "ColorF1Green", "ColorF2Yellow", "ColorF3Blue",
    "ChannelUp", "ChannelDown"
  ],
  "files": ["app", "README.md", "LICENSE"]
}
