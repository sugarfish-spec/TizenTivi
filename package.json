{
  "name": "tivimate-style-iptv-tizenbrew",
  "version": "1.0.5",
  "description": "Remote-first IPTV player for TizenBrew with Xtream Codes, M3U/M3U8 and XMLTV EPG support.",
  "packageType": "app",
  "appName": "TizenTivi",
  "appPath": "app/index.html",
  "main": "app/index.html",
  "keys": [
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackPrevious",
    "MediaTrackNext"
  ],
  "evaluateScriptOnDocumentStart": false,
  "files": [
    "app",
    "README.md",
    "LICENSE"
  ]
}
